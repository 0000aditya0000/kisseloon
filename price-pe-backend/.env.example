# Server
PORT=3000
NODE_ENV=development

# Database (matches docker-compose.yml host port)
DB_HOST=localhost
DB_PORT=55432
DB_NAME=pricepe
DB_USER=postgres
DB_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:55432/pricepe
REDIS_URL=redis://localhost:6379

# Playwright scrapers
SCRAPPER_HEADLESS=true
SCRAPPER_DEFAULT_LOCATION=bangalore
SCRAPPER_REQUEST_DELAY=2000
SCRAPPER_MAX_RETRIES=3
SCRAPPER_SEARCH_TIMEOUT_MS=180000

# Logging
LOG_LEVEL=debug
